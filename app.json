{
  "expo": {
    "name": "Vinsure",
    "slug": "visezy-insurance",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.visezy.insurance",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.visezy.insurance"
    },
    "plugins": [
      "expo-image-picker",
      "expo-status-bar",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "49fd17b4-4d2c-457b-9362-c25c06a02057"
      }
    }
  }
}
